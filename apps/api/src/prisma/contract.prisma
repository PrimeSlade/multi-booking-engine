// use prisma-next

enum BookingStatus {
  @@type("pg/text@1")
  in_progress            = "in_progress"
  awaiting_user_decision = "awaiting_user_decision"
  partially_confirmed    = "partially_confirmed"
  confirmed              = "confirmed"
  failed                 = "failed"
}

enum StepScope {
  @@type("pg/text@1")
  product   = "product"
  itinerary = "itinerary"
}

enum StepStatus {
  @@type("pg/text@1")
  pending      = "pending"
  in_progress  = "in_progress"
  success      = "success"
  failed       = "failed"
  compensating = "compensating"
  compensated  = "compensated"
}

model Booking {
  id     String @id @default(uuid())
  userId String @map("user_id")

  status            BookingStatus      @default(in_progress)
  decisionExpiresAt TimestamptzString? @map("decision_expires_at")

  createdAt TimestamptzString          @default(now()) @map("created_at")
  updatedAt temporal.updatedAtString() @map("updated_at")

  flightBookings FlightBooking[]
  hotelBookings  HotelBooking[]
  steps          BookingStep[]

  @@map("booking")
}

model FlightBooking {
  id        String  @id @default(uuid())
  bookingId String  @map("booking_id")
  booking   Booking @relation(fields: [bookingId], references: [id])

  flightId      String            @map("flight_id")
  flightNumber  String?           @map("flight_number")
  origin        String
  destination   String
  departureDate TimestamptzString @map("departure_date")
  passengers    Int               @default(1)

  steps BookingStep[]

  @@index([bookingId])
  @@map("flight_booking")
}

model HotelBooking {
  id        String  @id @default(uuid())
  bookingId String  @map("booking_id")
  booking   Booking @relation(fields: [bookingId], references: [id])

  hotelId   String            @map("hotel_id")
  hotelName String?           @map("hotel_name")
  roomId    String?           @map("room_id")
  roomType  String?           @map("room_type")
  city      String
  checkIn   TimestamptzString @map("check_in")
  checkOut  TimestamptzString @map("check_out")
  rooms     Int               @default(1)

  steps BookingStep[]

  @@index([bookingId])
  @@map("hotel_booking")
}

model BookingStep {
  id        String  @id @default(uuid())
  bookingId String  @map("booking_id")
  booking   Booking @relation(fields: [bookingId], references: [id])

  flightBookingId String?        @map("flight_booking_id")
  flightBooking   FlightBooking? @relation(fields: [flightBookingId], references: [id])

  hotelBookingId String?       @map("hotel_booking_id")
  hotelBooking   HotelBooking? @relation(fields: [hotelBookingId], references: [id])

  stepIndex Int       @map("step_index")
  stage     Int
  stepName  String    @map("step_name")
  scope     StepScope
  agent     String

  status    StepStatus                 @default(pending)
  attempt   Int                        @default(0)
  retryable Boolean?
  result    Json?
  error     Json?
  updatedAt temporal.updatedAtString() @map("updated_at")

  // No composite unique constraint here: Postgres exempts a row from a
  // multi-column unique check entirely once any column in it is NULL, and
  // every product-scope step has exactly one of flightBookingId/
  // hotelBookingId NULL by design. GraphService + BookingService's fan-out
  // already guarantee no duplicate (bookingId, stepName, item) rows.
  @@index([bookingId])
  @@index([flightBookingId])
  @@index([hotelBookingId])
  @@index([status])
  @@index([bookingId, stage])
  @@map("booking_step")
}

model Hotel {
  id   String @id
  name String
  city String

  rooms Room[]

  @@map("hotel")
}

model Room {
  id      String @id
  hotelId String @map("hotel_id")
  hotel   Hotel  @relation(fields: [hotelId], references: [id])

  roomType  String  @map("room_type")
  price     Decimal
  available Boolean @default(true)

  @@index([hotelId])
  @@map("room")
}

model Airline {
  id   String @id
  name String

  flights Flight[]

  @@map("airline")
}

model Flight {
  id        String  @id
  airlineId String  @map("airline_id")
  airline   Airline @relation(fields: [airlineId], references: [id])

  flightNumber  String            @map("flight_number")
  origin        String
  destination   String
  departureTime TimestamptzString @map("departure_time")
  price         Decimal
  seatsLeft     Int               @map("seats_left")

  @@index([airlineId])
  @@map("flight")
}

model FraudBlacklist {
  userId String @id @map("user_id")

  @@map("fraud_blacklist")
}
