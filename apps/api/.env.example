# Application
PORT=3000
NODE_ENV=development

# PostgreSQL (Docker Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=booking_engine
POSTGRES_PORT=5432

# RabbitMQ (Docker Compose)
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Database (PostgreSQL via Docker Compose)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/booking_engine?schema=public"

# RabbitMQ Connection
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# RabbitMQ Topology
RABBITMQ_EXCHANGE=booking.topic
RABBITMQ_PREFETCH=50

# Booking Graph Definition (optional override, defaults to bundled YAML)
GRAPH_CONFIG_PATH=

# RabbitMQ Queues
RABBITMQ_BOOKINGS_QUEUE=bookings_queue
RABBITMQ_NOTIFICATIONS_QUEUE=notifications_queue
