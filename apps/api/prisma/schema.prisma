generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Booking {
  id       String @id @default(uuid())
  userId   String @map("user_id")
  products Json // e.g. ["hotel", "flight"] — input to generateGraph()

  status            BookingStatus @default(in_progress)
  decisionExpiresAt DateTime?     @map("decision_expires_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  steps BookingStep[]

  @@map("booking")
}

enum BookingStatus {
  in_progress
  awaiting_user_decision
  partially_confirmed
  confirmed
  failed
}

model BookingStep {
  id        String  @id @default(uuid())
  bookingId String  @map("booking_id")
  booking   Booking @relation(fields: [bookingId], references: [id])

  // structure — set once, at generation time
  stepIndex Int       @map("step_index")
  stage     Int
  stepName  String    @map("step_name") // 'allotment.hotel', 'payment', etc.
  scope     StepScope
  product   String? // 'hotel' | 'flight' | null (itinerary-scoped)
  agent     String // routing target: 'availability' | 'fraud' | 'payment' | 'allotment' | 'notify'

  // execution state — mutated as the graph runs
  status    StepStatus @default(pending)
  attempt   Int        @default(0)
  retryable Boolean?
  result    Json?
  error     Json?
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@unique([bookingId, stepName]) // idempotency guard
  @@index([bookingId])
  @@index([status]) // stuck-step sweep
  @@index([bookingId, stage]) // "what's the current stage" query
  @@map("booking_step")
}

enum StepScope {
  product
  itinerary
}

enum StepStatus {
  pending
  in_progress
  success
  failed
  compensating
  compensated
}
