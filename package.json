{
  "name": "multi-booking-engine-monorepo",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "dev:api": "pnpm --filter @booking/api start:dev",
    "dev:web": "pnpm --filter @booking/web dev",
    "build": "pnpm -r build",
    "build:api": "pnpm --filter @booking/api build",
    "build:web": "pnpm --filter @booking/web build",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"apps/**/*.{ts,tsx,js,jsx,json,md}\"",
    "test": "pnpm --filter @booking/api test",
    "seed": "pnpm --filter @booking/api seed",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.4.2"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@10.29.2"
}
