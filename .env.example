# Application
PORT=3000
NODE_ENV=development

# Database (PostgreSQL via Docker Compose)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/booking_engine?schema=public"

# RabbitMQ Connection
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# RabbitMQ Queues
RABBITMQ_BOOKINGS_QUEUE=bookings_queue
RABBITMQ_NOTIFICATIONS_QUEUE=notifications_queue
